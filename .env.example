# Copy to .env and fill in. Every variable is read once at startup by
# lib/config.js — a missing required value fails immediately with a list of
# what's absent, rather than degrading into silent fallbacks at answer time.
#
# On Railway these go in the service's Variables tab instead of a file.

# ─── required ────────────────────────────────────────────────────────────────

# Your Slack app's bot token. Slack app → OAuth & Permissions.
SLACK_BOT_TOKEN=xoxb-

# App-level token for Socket Mode, with the connections:write scope.
# Slack app → Basic Information → App-Level Tokens.
# Socket Mode means the bot dials out to Slack and listens on no port at all —
# no public URL, no tunnel, no domain needed. Orry does not use
# SLACK_SIGNING_SECRET from the HTTP-receiver setup used by Pixorpheus.
SLACK_APP_TOKEN=xapp-

# Comma-separated channel IDs the bot watches. The FIRST entry is the
# auto-reply channel. For program answers, these IDs must also be claimed in
# that program's channels/helpChannel configuration.
SLACK_FAQ_CHANNELS=C0000000000,C1111111111

# The model key Orry actually requires. validate() refuses to start without it.
# This is the OpenCode Zen key for the default intent classifier and fallback tiers.
OPENCODE_API_KEY=

# Optional: one dedicated support channel that replies to every top-level post.
# Leave unset when the program channel should answer only real questions.
# Channel ID (not name): Slack channel details → ID at the bottom.
SLACK_HELP_CHANNEL=

# Optional: Hack Club AI key, for the hosted tier. Not required by validate().
# When set, answer/help/ping/vision use HCAI tiers with the per-task model
# overrides below; HCAI_INTENT_MODEL opts the engagement classifier into HCAI.
# Create it at https://ai.hackclub.com/.
HCAI_API_KEY=

# ─── your bot's identity ─────────────────────────────────────────────────────

# What the bot calls itself in every message it writes.
ORRY_BOT_NAME=Orry the ore Maulwürf

# Command prefix. This one is load-bearing: it becomes every slash command
# (/orry, /orry-teach, /orry-gaps) and must match the generated Slack manifest.
# Slash command names are unique per workspace, so if another bot in the same
# workspace already uses this prefix, the second app will fail to install.
ORRY_BOT_SLUG=orry

# Slack user IDs allowed to teach the bot and see the maintainer commands.
# Fails CLOSED: empty means nobody can ever teach it anything. Put your own
# ID here.
ORRY_ADMIN_USER_IDS=

# ─── what the bot knows ──────────────────────────────────────────────────────

# The whole per-program config as one JSON value: channels, docs, posture,
# guides, dates. Set this to override the ignored config/programs.json fallback,
# which lets one unmodified copy of this repo serve any program.
#
# Source types: "url" (docs site, follows subpages), "github-dir" (GitHub
# contents API directory of markdown; add siteUrl for the rendered version),
# "json-faq" (inline "content", or a "url"), "text" (inline prose), and
# "live-shop" (the public Live reward catalogue).
#
# posture: "active" answers whenever it can, "passive" only when addressed,
#          "muted" stays silent (useful while setting up).
# scope:   "program" only answers questions about this program and leaves
#          everything else to the humans; "any" answers anything someone's
#          stuck on. Being pinged or DM'd bypasses either.
#
# Leave unset to fall back to config/programs.json if you create that ignored file.
# loadout/program.json is an example and is not loaded automatically.
#
# Older RIVET_* names still work as fallbacks; ORRY_* is the current name.
# ORRY_PROGRAMS_JSON=[{"id":"myprogram","name":"My Program","helpChannel":"C0000000000","channels":["C0000000000"],"posture":"active","scope":"program","guides":["submit-ysws-guidelines"],"sources":[{"name":"My Docs","type":"url","url":"https://example.com/docs"},{"name":"My FAQ","type":"json-faq","content":[{"question":"What is this?","answer":"A thing."}]}],"milestones":[{"name":"Launch","date":"2026-09-01"}]}]

# How often to re-fetch the docs, in minutes.
REFRESH_INTERVAL_MIN=30

# For doc sites that need JavaScript to render. Optional — plain HTML and
# markdown sources need nothing.
FIRECRAWL_API_KEY=

# ─── persistence ─────────────────────────────────────────────────────────────

# Where the SQLite file lives. On Railway, attach a volume and point this
# inside it — without one, every redeploy discards the answer cache, everything
# the bot has been taught, ticket records, and the last-good copy of the docs.
# ORRY_DB_PATH=/data/rivet.db

# ─── classifier model settings ────────────────────────────────────────────────

# The legacy intent classifier uses this tested, low-latency OpenCode Zen model
# by default. Override only when the selected provider supports your model name.
# INTENT_CLASSIFIER_MODEL=gpt-4.1-nano
# INTENT_REASONING_EFFORT=low
# INTENT_MAX_TOKENS=2000
# INTENT_TIMEOUT_MS=10000

# HCAI task-specific model overrides. These use HCAI_API_KEY and rotate any
# numbered HCAI_API_KEY_2, HCAI_API_KEY_3, ... keys too. Unset entries use the
# built-in task defaults. HCAI_INTENT_MODEL opts intent classification into HCAI.
# HCAI_BASE_URL=https://ai.hackclub.com/proxy/v1
# HCAI_MODEL=openrouter/free
# HCAI_PING_MODEL=openrouter/free
# HCAI_HELP_MODEL=openrouter/free
# HCAI_INTENT_MODEL=gpt-4.1-nano
# HCAI_VISION_MODEL=xiaomi/mimo-v2-omni

# ─── Jev engagement classifier (all optional) ────────────────────────────────

# Jev — the engagement classifier ("should Orry engage, and what kind of
# message is this?"). It never sees documentation and never decides whether
# Orry can answer; retrieval + grounding do. Experiential Labs only, free
# model only, one bounded request, no provider/model fallback. When disabled
# (or no key), the older intent classifier fills the same role.
# JEV_ENABLED=true
JEV_API_KEY=
# ^ secret: set in Railway Variables, never commit (EXPERIENTIAL_API_KEY is
#   still read as a fallback name for older deployments)
# OpenCode Zen:        JEV_BASE_URL=https://opencode.ai/zen/v1/systemone  JEV_MODEL=jev-1.13-free
# Experiential Labs:   JEV_BASE_URL=https://api.experientiallabs.ai/v1/systemone  JEV_MODEL=jev-latest:free
# The model must end in :free or -free; anything else is refused.
# JEV_TIMEOUT_MS=8000
# JEV_ENGAGE_THRESHOLD=0.7
# Where Orry engages is a per-program dashboard setting, not an env list.

# ─── Vey decision runtime (all optional) ────────────────────────────────────

# Vey — a decision runtime (https://github.com/fazin-ahamed/vey) that classifies
# a message with no generated text at all: ~2.6 ms p50 on CPU. It runs as a
# Python sidecar next to Orry, so point VEY_BASE_URL at it. When VEY is enabled
# it is tried first; if it is disabled, unreachable, or answers with a label
# Orry does not know, Orry falls back to the Jev classifier and then to the
# legacy intent classifier. If Jev errors, Orry also falls back to legacy
# intent; unprompted replies stay silent only when all classifiers fail. Vey and
# Jev are both off by default.
# VEY_ENABLED=true
# VEY_BASE_URL=http://127.0.0.1:8787
# The sidecar must answer POST {VEY_BASE_URL}/decide with the intent label and
# Orry's engagement call; see lib/veyDecision.ts for the exact wire contract.
# VEY_TIMEOUT_MS=3000
# VEY_ENGAGE_THRESHOLD=0.7

# ─── behaviour (all optional) ────────────────────────────────────────────────

# Emoji the bot adds to a help-channel question the docs couldn't answer, as a
# flag for humans. Unset disables the handoff.
# ORRY_ESCALATE_REACTION=sos

# Emojis pre-placed on the bot's own answers so voting is one click. On by
# default: thumbsup (helpful) and thumbsdown (not helpful). Leave this blank for the
# default, set your own comma list to change them, or set it to 0 to turn the
# pre-placed reactions off. Use Slack's reaction names (no colons). Names must be
# ones the bot counts (UP_REACTIONS / DOWN_REACTIONS in lib/reactionHandlers.ts).
# ORRY_FEEDBACK_REACTIONS=thumbsup,thumbsdown
# ORRY_FEEDBACK_REACTIONS=0

# What the bot does with a question about the program that the docs don't
# cover, asked in a busy main channel nobody addressed it in. react (default)
# adds a :thinking_face: reaction and posts nothing. silent posts nothing.
# reply posts the public "not confirmed yet" line.
# ORRY_AMBIENT_UNCERTAIN_REPLY=react

# Where the weekly report goes. Defaults to the help channel. Unset with no
# help channel disables the scheduled post; the report command still works.
# ORRY_REPORT_CHANNEL=

# Replaces the built-in "who are you / what can you do" answers wholesale.
# Useful when the generated ones don't fit.
# ORRY_IDENTITY_OVERRIDE=

# Per-message debug logging. Verbose.
# ORRY_DEBUG=0

# ─── hosted shared mode (central @Orry serving many programs) ──────────────

# Slack workspace (team) id all tenant boundaries scope to. Channel IDs repeat
# across workspaces, so hosted channel ownership, tickets, and dedupe key on
# workspace + channel/message. Single-workspace deployments may leave unset.
# ORRY_WORKSPACE_ID=T0000000000

# Shared secret for the Wizard → Core control-plane API (/internal/v1/*).
# Set a long random value; without it the internal API stays disabled and the
# Wizard dashboard cannot sync programs or act on tickets.
# ORRY_INTERNAL_TOKEN=
# Optional second token for read-only callers (a status site, a metrics
# reader). It is accepted only for GET routes and POST
# /internal/v1/slack/users/info; anything else answers 403. Use a different
# long random value from ORRY_INTERNAL_TOKEN. RIVET_INTERNAL_READ_TOKEN still
# works as a fallback name.
# ORRY_INTERNAL_READ_TOKEN=

# ─── web console (optional, off unless SLACK_CLIENT_ID is set) ───────────────

# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# ORRY_WEB_URL=
# ORRY_WEB_PORT (RIVET_WEB_PORT still works) wins over PORT. Leave PORT unset
# when another process on the same host uses it. A port already in use leaves
# the console off; the bot keeps running.
# ORRY_WEB_PORT=4100
# Interface to bind (ORRY_WEB_HOST; RIVET_WEB_HOST still works). Default
# 0.0.0.0 (Railway, Docker). Use 127.0.0.1 when a neighbour on the same host
# reads the bridge over loopback. An empty value is refused.
# ORRY_WEB_HOST=0.0.0.0
# Sign-in cookies. Without it a random one is generated per boot, so every
# restart logs everyone out.
# ORRY_SESSION_SECRET=
